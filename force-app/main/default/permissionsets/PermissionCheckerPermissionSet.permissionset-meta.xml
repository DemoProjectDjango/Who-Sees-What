<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>PermissionCheckerPermissionSet</label>
    <description>Assign to administrators who may inspect other users' permissions. Every inspection is written to Inspection Log and cannot be edited or deleted from here.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <applicationVisibilities>
        <application>Who_Sees_What</application>
        <visible>true</visible>
    </applicationVisibilities>

    <customPermissions>
        <enabled>true</enabled>
        <name>Use_Permission_Explorer</name>
    </customPermissions>

    <classAccesses>
        <apexClass>PermissionExplorerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>PE_Inspection_Log__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>PE_Inspection_Log__c.Detail__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>PE_Inspection_Log__c.Inspector_User__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <fieldPermissions>
        <field>PE_Inspection_Log__c.Subject_User__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <tabSettings>
        <tab>Permission_Explorer</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <tabSettings>
        <tab>License_Inspector</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <tabSettings>
        <tab>Getting_Started</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>