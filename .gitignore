# Git ignore rules for the Who Sees What project.
# See https://git-scm.com/docs/gitignore

# ---------------------------------------------------------------------------
# Salesforce CLI local state
# ---------------------------------------------------------------------------
.sf/
.sfdx/
.localdevserver/
deploy-options.json
destructive/

# LWC VS Code autocomplete (regenerated by the Salesforce extensions)
**/lwc/jsconfig.json

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
coverage/
.eslintcache

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Static analysis output — regenerate on demand with `npm run scan`
# ---------------------------------------------------------------------------
.pmdCache
analyzer-*.html
analyzer-*.json
apexdoc*
appexchange.json
baseline.*
code-analyzer-full.yml
wsw-analyzer*.html
p0.json
p1.*
braces.json
braces-worklist.txt

# Note: code-analyzer-reports/ is intentionally tracked as security-review
# evidence. See docs/CLEANUP-CANDIDATES.md if that decision is revisited.

# ---------------------------------------------------------------------------
# Environment and secrets — never commit credentials, tokens or auth URLs
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Python (Salesforce Functions leftovers)
# ---------------------------------------------------------------------------
**/__pycache__/
**/.venv/
**/venv/
